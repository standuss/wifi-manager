[Unit]
Description=WiFi Manager MikroTik synchronizace
After=network-online.target apache2.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wifimanager
ExecStart=/usr/bin/php /var/www/wifimanager/bin/worker.php
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/wifimanager/storage
ProtectHome=true

[Install]
WantedBy=multi-user.target

