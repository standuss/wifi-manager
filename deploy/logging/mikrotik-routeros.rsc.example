# WiFi Manager – šablona pro RouterOS 7. Před použitím nahraďte SERVER_IP.
# TCP/CEF je preferovaný pro centrální router. Starší CAP může použít UDP port 514.

/system logging action
add name=wifimanagerRemote target=remote remote=SERVER_IP remote-port=5514 remote-protocol=tcp remote-log-format=cef

/system logging
add action=wifimanagerRemote topics=critical
add action=wifimanagerRemote topics=error
add action=wifimanagerRemote topics=warning
add action=wifimanagerRemote topics=account
add action=wifimanagerRemote topics=system,info
add action=wifimanagerRemote topics=interface,info
add action=wifimanagerRemote topics=caps,info
add action=wifimanagerRemote topics=wireless,info
add action=wifimanagerRemote topics=dhcp,info

# Nezapínejte plošné firewall,debug logování – rychle zaplní archiv.
# IPFIX odesílá pouze centrální gateway; CAPy odesílají jen syslog.
/ip traffic-flow
set enabled=yes interfaces=all cache-entries=128k active-flow-timeout=1m inactive-flow-timeout=15s packet-sampling=no
/ip traffic-flow target
add dst-address=SERVER_IP port=2055 version=ipfix v9-template-refresh=20 v9-template-timeout=1m src-address=0.0.0.0
/ip traffic-flow ipfix
set bytes=yes packets=yes protocol=yes src-address=yes dst-address=yes src-port=yes dst-port=yes src-mac-address=yes dst-mac-address=yes first-forwarded=yes last-forwarded=yes in-interface=yes out-interface=yes nat-src-address=yes nat-dst-address=yes nat-src-port=yes nat-dst-port=yes tcp-flags=yes
