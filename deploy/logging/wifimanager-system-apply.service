[Unit]
Description=Apply validated WiFi Manager system settings
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/php /usr/local/lib/wifimanager/apply-system-settings.php
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# apply-system-settings.php zapisuje konfigurace atomicky přes dočasný soubor
# ve stejném adresáři a následný rename. Proto musí být zapisovatelné cílové
# adresáře, ne pouze již existující cílové soubory.
ReadWritePaths=/etc/default /etc/rsyslog.d /etc/wifimanager /var/lib/wifimanager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
